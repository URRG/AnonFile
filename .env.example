# Development-only defaults. Copy this file to .env and replace all secrets.
# Never commit .env, production keys, customer data, or generated release artifacts.

POSTGRES_DB=anonflow
POSTGRES_USER=anonflow
POSTGRES_PASSWORD=change-me-local-postgres
DATABASE_URL=postgresql+psycopg://anonflow:change-me-local-postgres@postgres:5432/anonflow

REDIS_URL=redis://redis:6379/0
TEMPORAL_ADDRESS=temporal:7233

MINIO_ROOT_USER=anonflow-local
MINIO_ROOT_PASSWORD=change-me-local-minio-password
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=anonflow-local
S3_SECRET_KEY=change-me-local-minio-password
S3_BUCKET_RAW=anonflow-raw
S3_BUCKET_WORKING=anonflow-working
S3_BUCKET_QUARANTINE=anonflow-quarantine
S3_BUCKET_RELEASE=anonflow-release

# API values
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
JWT_SIGNING_KEY=replace-with-a-32-byte-development-secret
RELEASE_SIGNING_KEY=replace-with-a-different-32-byte-development-secret
LOG_LEVEL=INFO

# Keep false unless a customer-approved egress policy exists.
ALLOW_CLOUD_LLM=false
OIDC_ISSUER=
OIDC_AUDIENCE=anonflow
