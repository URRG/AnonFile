# Synthetic-only local development. No shared or hard-coded token is provided.
# Copy to .env; populate the JSON array with independently generated random tokens.
# Each entry: token (32+ characters), subject, tenant, roles (processor/reviewer/buyer/evaluator).
# Generate each token locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use different subjects for processor and reviewer. Never commit populated .env.
ANONFLOW_ENV=development
ANONFLOW_DEV_PRINCIPALS=[]
ANONFLOW_AUTH_MODE=dev-token
# Optional pinned-JWKS access-token verifier, not OIDC login. See
# docs/implementation-m20-oidc-identity.md.  This is the only accepted
# authentication mode when ANONFLOW_ENV=production; dev-token is prohibited.
# ANONFLOW_AUTH_MODE=jwt
# ANONFLOW_JWT_ISSUER=https://issuer.example.test
# ANONFLOW_JWT_AUDIENCE=anonflow-local
# ANONFLOW_JWKS_PATH=C:/private/anonflow-public-jwks.json
# ANONFLOW_JWT_BINDINGS=[{"subject":"operator","tenant":"synthetic","roles":["processor"]}]
ANONFLOW_STORAGE_MODE=memory
# Optional evaluator service attestation for M9 aggregate benchmark evidence.
# Keep the base64 HMAC key in a secret store; never expose it to processors or
# commit it. With this unset, evidence submission fails closed.
# ANONFLOW_EVALUATOR_AUTHORITIES=[{"subject":"evaluator-worker","tenant":"synthetic","evaluator_id":"m8-harness","evaluator_version":"v1","evaluator_config_digest":"sha256:<64-lowercase-hex>","corpus_digests":["sha256:<64-lowercase-hex>"],"key":"<base64-32-byte-key>"}]
# Optional M14 release-case issuer. This creates only a signed, non-authorizing
# scope record; it never approves, releases, or delivers data. Keep the Ed25519
# private key and recipient HMAC salt in a secret manager, not in this file.
# ANONFLOW_RELEASE_CASE_AUTHORITIES=[{"tenant":"synthetic","issuer_key_id":"release-case-2026-01","expires_at":"2027-01-01T00:00:00Z","private_key":"<base64-32-byte-private-key>","recipient_commitment_salt":"<base64-random-32-byte-salt>","contract_reference":"contract-reference:v1:<43-base64url-chars>","contract_digest":"sha256:<64-lowercase-hex>","contract_expires_at":"2027-01-01T00:00:00Z"}]
# Optional M15 privacy-decision authority.  Each requirement has a distinct
# Ed25519 key and maps one M12 V2 evidence family to its threshold.  Native
# reports are still re-verified using their original authority before this
# key can attest them.  Missing residual/benchmark candidate evidence holds
# the case; this configuration never approves or delivers data.
# ANONFLOW_PRIVACY_DECISION_AUTHORITIES=[{"tenant":"synthetic","issuer_key_id":"privacy-decision-2026-01","expires_at":"2027-01-01T00:00:00Z","private_key":"<base64-32-byte-private-key>","max_evidence_age_seconds":3600,"requirements":[{"kind":"RESIDUAL_SCAN","threshold":0,"issuer_key_id":"privacy-residual","key":"<base64-32-byte-private-key>"},{"kind":"DISCLOSURE_RISK","threshold":1,"issuer_key_id":"privacy-disclosure","key":"<base64-32-byte-private-key>"},{"kind":"UTILITY","threshold":1000000,"issuer_key_id":"privacy-utility","key":"<base64-32-byte-private-key>"},{"kind":"LINKAGE","threshold":0,"issuer_key_id":"privacy-linkage","key":"<base64-32-byte-private-key>"},{"kind":"BENCHMARK","threshold":1000000,"issuer_key_id":"privacy-benchmark","key":"<base64-32-byte-private-key>"}]}]
# Optional M18 independent-authorization workflow. This records an Ed25519
# signed pending request plus two distinct configured human signatures only.
# Both configured subjects must be separate development identities with the
# reviewer role.  It exposes no artifact, recipient, credential, approval
# token, export, or delivery path; missing/invalid configuration fails closed.
# ANONFLOW_RELEASE_AUTHORIZATION_AUTHORITIES=[{"tenant":"synthetic","issuer_key_id":"release-authorization-2026-01","expires_at":"2027-01-01T00:00:00Z","private_key":"<base64-32-byte-private-key>","approvers":[{"subject":"privacy-human","approval_role":"privacy_reviewer","public_key":"<base64-ed25519-public-key>"},{"subject":"release-human","approval_role":"release_authorizer","public_key":"<base64-ed25519-public-key>"}]}]
# Optional M21 readiness issuer. It signs only a bounded, source-safe control
# record after live M14/M15/M18 verification; it is never an export or delivery
# mechanism and must be held separately from human approval keys.
# ANONFLOW_DELIVERY_READINESS_AUTHORITIES=[{"tenant":"synthetic","issuer_key_id":"delivery-readiness-2026-01","expires_at":"2027-01-01T00:00:00Z","private_key":"<base64-32-byte-private-key>"}]
# Opt-in local encrypted persistence; path parent must already exist.
# Never commit the populated key or store it next to the database.
# ANONFLOW_STORAGE_MODE=sqlite
# ANONFLOW_DB_PATH=C:/private/anonflow-local.db
# ANONFLOW_STORAGE_KEY=<base64-encoded-random-32-byte-key>
WEB_ORIGIN=http://localhost:3000,http://localhost:5173
# Build-time browser URL, not a runtime frontend variable.
VITE_API_URL=http://localhost:8000
